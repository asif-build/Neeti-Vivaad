# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=neeti_vivaad
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# Or Database URL format:
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/neeti_vivaad

# Django Settings
DJANGO_SECRET_KEY=django-insecure-neeti-vivaad-sih2026-mospi-secret-key-key-12345
DEBUG=True

# NVIDIA NIM hosted API (create a free prototype key at https://build.nvidia.com/)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
